[Unit]
Description=linux-mcp filesystem MCP server (read-oriented ops agent)
Documentation=https://github.com/KaribuLab/linux-mcp
After=network.target

[Service]
Type=simple
User=mcp-agent
Group=mcp-agent
ExecStart=/usr/local/bin/linux-mcp serve
Restart=on-failure
RestartSec=2

# Token issuance socket. RuntimeDirectory gives the service a writable
# /run/linux-mcp under ProtectSystem=strict, and systemd removes it on stop.
# The directory is traversable by everyone; the socket itself is what
# restricts issuance, at 0660 mcp-agent:mcp-admin.
RuntimeDirectory=linux-mcp
RuntimeDirectoryMode=0755
SupplementaryGroups=mcp-admin

# Elevated read for ops visibility; app-level denylist remains mandatory.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=true

# Write hardening: read-mostly agent.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
# No SystemCallFilter=@system-service: on several LTS hosts that whitelist
# returns EPERM for a syscall Go 1.26 needs at startup and the process SEGV.

# The token signing key lives only in memory: no core dump may leak it, and
# other users must not be able to inspect this process.
LimitCORE=0
ProtectProc=invisible

# Unix issuance socket, loopback HTTP, and netlink for ss/ss_grep (sock_diag).
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

# Complement (not substitute) for in-process path policy.
InaccessiblePaths=/etc/shadow /etc/gshadow /root

# The MCP endpoint binds 127.0.0.1:5000 by default (serve --addr).

[Install]
WantedBy=multi-user.target
